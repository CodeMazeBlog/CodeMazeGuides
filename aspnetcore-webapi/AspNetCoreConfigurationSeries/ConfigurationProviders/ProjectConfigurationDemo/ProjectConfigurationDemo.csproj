<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>d5a08119-f24b-42c7-a729-38895bb7b067</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The ASP.NET Core shared framework already supplies the INI provider on
         net10.0, so NuGet reports this reference as redundant (NU1510). It is kept
         because the article tells the reader to install it, and because a reader
         who follows the same steps in a non-web project does need it. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Ini" Version="10.0.11" NoWarn="NU1510" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.ini" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
