{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "JwtSettings": {
    "ValidIssuer": "WebApiBestPractices",
    "ValidAudience": "https://localhost:5001"
  },
  "RateLimiting": {
    "PermitLimit": 100
  }
}
